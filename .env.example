# =============================================================================
# LENA — environment variables reference
# Copy this file to .env and fill in real values.  Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL  (used by: lena app, Zep, Langfuse)
# -----------------------------------------------------------------------------

# Password for the 'lena' PostgreSQL user.
# Used in docker-compose and by lena/db/connection.py (via DATABASE_URL).
LENA_DB_PASSWORD=change_me

# Full SQLAlchemy async DSN used by lena/db/connection.py.
# Optional — auto-constructed from memory.mem0.vector_store config if unset.
# For local Docker setup: postgresql+psycopg://lena:<LENA_DB_PASSWORD>@localhost:5432/lena
DATABASE_URL=postgresql+psycopg://lena:change_me@localhost:5432/lena

# Test database URL used by pytest integration tests (separate DB from production).
# For local Docker setup: postgresql+psycopg://lena:<LENA_DB_PASSWORD>@localhost:5432/lena_test
LENA_TEST_DB_URL=postgresql+psycopg://lena:change_me@localhost:5432/lena_test

# -----------------------------------------------------------------------------
# Zep  (long-term memory service)
# -----------------------------------------------------------------------------

# Secret used by Zep for signing JWTs.  Generate with: openssl rand -hex 32
ZEP_AUTH_SECRET=change_me

# API key for the Zep client (lena.config.yaml → memory.zep.api_key).
ZEP_API_KEY=change_me

# -----------------------------------------------------------------------------
# Langfuse  (LLM observability)
# -----------------------------------------------------------------------------

# NextAuth secret — generate with: openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=change_me

# Argon2 salt — generate with: openssl rand -hex 32
LANGFUSE_SALT=change_me

# Public URL shown to browsers (change for remote deployments).
LANGFUSE_NEXTAUTH_URL=http://localhost:3000

# Project keys surfaced to LENA adapters / OpenTelemetry exporter.
LANGFUSE_PUBLIC_KEY=pk-lf-change_me
LANGFUSE_SECRET_KEY=sk-lf-change_me

# Optional: seed an org/project/user on first boot.
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# -----------------------------------------------------------------------------
# LLM provider API keys  (read by Anthropic / OpenAI / Gemini SDKs at runtime)
# -----------------------------------------------------------------------------

ANTHROPIC_API_KEY=sk-ant-change_me
OPENAI_API_KEY=sk-change_me
GEMINI_API_KEY=change_me

# -----------------------------------------------------------------------------
# OpenTelemetry  (optional — Langfuse acts as the OTEL collector)
# -----------------------------------------------------------------------------

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3000/api/public/otel
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic change_me
